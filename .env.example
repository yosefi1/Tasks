# Neon PostgreSQL (dev + production)
# Get both from: https://console.neon.tech → your project → Connection string
# Use "Pooled connection" for DATABASE_URL (serverless-friendly)
# Use "Direct connection" for DIRECT_URL (migrations)

DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
